# Use the below flags to enable the Analytics or ActivityPub containers as well
COMPOSE_PROFILES=analytics,activitypub

# GitHub Container Registry
GITHUB_USERNAME=YOUR_GITHUB_USERNAME_HERE

# Ghost domain
# Custom public domain Ghost will run on
DOMAIN=CHANGE_ME_YOUR_DOMAIN

# Ghost Admin domain
# If you have Ghost Admin setup on a separate domain uncomment the line below and add the domain
# You also need to uncomment the corresponding server block in nginx/nginx.conf
ADMIN_DOMAIN=CHANGE_ME_YOUR_ADMIN_DOMAIN

# Database settings - REPLACE WITH YOUR SECURE VALUES
# All database settings must not be changed once the database is initialised  
DATABASE_ROOT_PASSWORD=CHANGE_ME_SECURE_ROOT_PASSWORD
DATABASE_USER=CHANGE_ME_DATABASE_USER
DATABASE_PASSWORD=CHANGE_ME_SECURE_DATABASE_PASSWORD

# ActivityPub
# If you'd prefer to self-host ActivityPub yourself uncomment the line below
ACTIVITYPUB_TARGET=activitypub:8080

# Tinybird configuration - REPLACE WITH YOUR VALUES FROM TINYBIRD SETUP
# If you want to run Analytics, paste the output from `docker compose run --rm tinybird-login get-tokens` below
TINYBIRD_API_URL=https://api.tinybird.co
TINYBIRD_TRACKER_TOKEN=p.eyJ_PASTE_FROM_TINYBIRD_SETUP_HERE
TINYBIRD_ADMIN_TOKEN=p.eyJ_PASTE_FROM_TINYBIRD_SETUP_HERE  
TINYBIRD_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Ghost configuration (https://ghost.org/docs/config/)

# Mailgun Email Configuration (https://ghost.org/docs/config/#mail)
# Transactional email is required for logins, account creation (staff invites), password resets and other features
# This is not related to bulk mail / newsletter sending

# Mailgun API Configuration (for local development/testing)
# For production, these values are set via GitHub Secrets in CI/CD
mail__transport=Mailgun
mail__options__auth__api_key=REPLACE_WITH_YOUR_MAILGUN_PRIVATE_API_KEY
mail__options__auth__domain=REPLACE_WITH_YOUR_MAILGUN_DOMAIN
mail__options__host=api.mailgun.net
mail__from=noreply@REPLACE_WITH_YOUR_MAILGUN_DOMAIN

# Note: Use api.eu.mailgun.net if your Mailgun account is in the EU region
# The auth__ prefix is critical - Ghost's Mailgun transport expects: auth: { api_key, domain }

# Advanced customizations

# Force Ghost version
# You should only do this if you need to pin a specific version
# The update commands won't work
# GHOST_VERSION=6-alpine

# Port Ghost should listen on
# You should only need to edit this if you want to host
# multiple sites on the same server
# GHOST_PORT=2368

# Proxy configuration - Required for proper operation behind reverse proxy
server__host=0.0.0.0
server__port=2368
privacy__useUpdateCheck=false
forceAdminSSL=false
proxy=true

# Data locations
# Location to store uploaded data
UPLOAD_LOCATION=./data/ghost

# Location for database data
MYSQL_DATA_LOCATION=./data/mysql

# =============================================================================
# ⚠️  CONFIGURATION REQUIRED - CHANGE ALL PLACEHOLDER VALUES ABOVE! 
# =============================================================================
# This file contains PLACEHOLDER values. You MUST replace:
#
# 🌐 DOMAINS:
# - DOMAIN (your main blog domain)
# - ADMIN_DOMAIN (your admin interface domain)
# - GITHUB_USERNAME (your GitHub username)
#
# 🔐 SENSITIVE/SECURITY VALUES:
# - DATABASE_ROOT_PASSWORD (secure MySQL root password)
# - DATABASE_PASSWORD (secure Ghost database password) 
# - TINYBIRD_TRACKER_TOKEN (from Tinybird setup)
# - TINYBIRD_ADMIN_TOKEN (from Tinybird setup)
# - TINYBIRD_WORKSPACE_ID (from Tinybird setup)
# - mail__options__auth__pass (Mailgun/SMTP password)
#
# 📧 EMAIL CONFIGURATION:
# - DATABASE_USER (your database username)
# - mail__options__host (your SMTP server)
# - mail__options__port (your SMTP port)
# - mail__options__auth__user (your SMTP username)
# 
# 🏭 FOR PRODUCTION CI/CD: 
# Store ALL values in GitHub Secrets for secure automated deployment
# =============================================================================
