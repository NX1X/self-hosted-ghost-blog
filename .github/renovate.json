{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "configMigration": true,
  "labels": ["dependencies"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "platformAutomerge": true,
  "dependencyDashboardTitle": "Renovate Dependency Dashboard",
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "labels": ["security"],
    "addLabels": ["security"],
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Batch every non-major update (Docker digest/patch/minor + GitHub Actions) into ONE weekly PR and automerge it once the 14-day cooldown has passed and CI is green. This is a template repo, so no running service is affected.",
      "matchUpdateTypes": ["digest", "pin", "pinDigest", "patch", "minor"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Major updates: keep as separate PRs, label them, and require a human to review and merge (potential breaking changes).",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "automerge": false,
      "addLabels": ["major"]
    }
  ]
}
