# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Shell scripts MUST be LF (they run on Linux CI and in containers).
*.sh text eol=lf
tb-wrapper text eol=lf
getTokens.sh text eol=lf
handleLogin.sh text eol=lf

# Keep these LF too for consistent diffs across platforms.
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.conf text eol=lf
*.json text eol=lf
Dockerfile text eol=lf

# PowerShell stays CRLF (native Windows tooling expectation).
*.ps1 text eol=crlf

# Binary assets: never touch line endings.
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.svg binary
